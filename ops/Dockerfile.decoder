# linux/amd64 is enforced by the build request and runtime invocation.
# Official Docker Library Python 3.12.11 slim-bookworm OCI index digest.
FROM python:3.12.11-slim-bookworm@sha256:519591d6871b7bc437060736b9f7456b8731f1499a57e22e6c285135ae657bf7

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app
COPY ops/decoder-pillow-requirements.lock /tmp/requirements.lock
RUN python -m pip install --no-cache-dir --require-hashes -r /tmp/requirements.lock \
    && python -c "import PIL,numpy; assert PIL.__version__ == '13.0.0'; assert numpy.__version__ == '2.5.4'"
COPY fieldwork/container_decoder.py /app/container_decoder.py
USER 65532:65532
ENTRYPOINT ["/usr/local/bin/python", "-I", "-B", "/app/container_decoder.py", "--container"]
